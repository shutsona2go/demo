---
// The Blue Meridian Club — splash page
// Hero photo lives at /public/hero.jpg (drop in when ready; uncomment the .hero-bg img rule)
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>The Blue Meridian Club</title>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
	</head>
	<body>
		<nav class="nav">
			<a href="/" class="wordmark">Blue Meridian</a>
			<ul class="nav-links">
				<li><a href="/destinations">Destinations</a></li>
				<li><a href="/membership">Membership</a></li>
				<li><a href="/journal">Journal</a></li>
				<li><a href="/inquire" class="nav-cta">Inquire</a></li>
			</ul>
		</nav>

		<main>
			<!-- ============ HERO ============ -->
			<section class="hero">
				<div class="hero-bg"></div>
				<div class="hero-overlay"></div>

				<!-- Permit fish: stylized silhouette, drifting -->
				<svg class="permit" viewBox="0 0 800 360" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
					<defs>
						<linearGradient id="permitBody" x1="0%" y1="0%" x2="0%" y2="100%">
							<stop offset="0%" stop-color="rgba(244,241,234,0.92)"/>
							<stop offset="55%" stop-color="rgba(206,220,232,0.78)"/>
							<stop offset="100%" stop-color="rgba(160,180,200,0.6)"/>
						</linearGradient>
						<linearGradient id="permitFin" x1="0%" y1="0%" x2="0%" y2="100%">
							<stop offset="0%" stop-color="rgba(212,175,111,0.85)"/>
							<stop offset="100%" stop-color="rgba(212,175,111,0.35)"/>
						</linearGradient>
					</defs>
					<path d="M 600,180 L 770,90 L 720,180 L 770,270 Z"
						fill="url(#permitBody)" stroke="rgba(10,22,40,0.35)" stroke-width="1.2"/>
					<path d="M 80,180
							 C 110,90 260,55 420,55
							 C 540,55 610,110 630,180
							 C 610,250 540,305 420,305
							 C 260,305 110,270 80,180 Z"
						fill="url(#permitBody)" stroke="rgba(10,22,40,0.4)" stroke-width="1.4"/>
					<path d="M 280,55 C 230,5 200,15 240,55 C 320,55 360,40 380,55 Z"
						fill="url(#permitFin)" stroke="rgba(10,22,40,0.25)" stroke-width="0.8"/>
					<path d="M 400,55 Q 480,40 560,60 L 540,72 Q 460,68 400,72 Z"
						fill="rgba(212,175,111,0.55)"/>
					<path d="M 300,305 C 240,360 220,340 260,305 C 340,305 380,320 400,305 Z"
						fill="url(#permitFin)" stroke="rgba(10,22,40,0.25)" stroke-width="0.8"/>
					<path d="M 320,210 C 270,260 220,300 180,340 C 240,300 290,250 330,225 Z"
						fill="rgba(10,22,40,0.55)" stroke="rgba(10,22,40,0.6)" stroke-width="0.5"/>
					<path d="M 180,95 Q 380,65 580,140"
						fill="none" stroke="rgba(10,22,40,0.32)" stroke-width="14" stroke-linecap="round" opacity="0.5"/>
					<path d="M 160,120 Q 175,180 160,240"
						fill="none" stroke="rgba(10,22,40,0.35)" stroke-width="1.5"/>
					<circle cx="125" cy="170" r="7" fill="#0a1628"/>
					<circle cx="122" cy="167" r="2.2" fill="#f4f1ea"/>
					<path d="M 82,195 Q 95,205 110,200"
						fill="none" stroke="rgba(10,22,40,0.5)" stroke-width="1.6" stroke-linecap="round"/>
				</svg>

				<div class="hero-content">
					<p class="eyebrow">— By Invitation —</p>
					<h1>The Blue Meridian Club</h1>
					<p class="tagline">Saltwater fly. Tropical waters.<br />The line where blue meets blue.</p>
					<a class="cta" href="/inquire">Inquire</a>
				</div>

				<div class="hero-footer">
					<span>Belize · Bahamas · Seychelles · Christmas Island</span>
				</div>
			</section>

			<!-- ============ WELLNESS PARTNER ============ -->
			<section class="partner">
				<div class="partner-grid">
					<div class="partner-image">
						<img src="https://olavedi.com/wp-content/uploads/2022/09/OlaStudio-800.jpg"
							 alt="Ola Avedissian, yoga and Pilates teacher" loading="lazy" />
					</div>
					<div class="partner-copy">
						<p class="eyebrow">— Wellness Partner —</p>
						<h2>Ola Avedissian</h2>
						<p class="partner-role">Yoga · Pilates · Retreats</p>
						<p class="partner-body">
							A wellness lifestyle community that empowers you to live your healthiest
							and happiest life. Yoga practice, workouts, retreats, &amp; food. Members of
							the Club receive priority access to private sessions and small-group retreats
							pre- and post-trip.
						</p>
						<a class="cta cta-light" href="https://olavedi.com" target="_blank" rel="noopener noreferrer">
							Visit OLAvedi
						</a>
					</div>
				</div>
			</section>

			<!-- ============ SITE FOOTER ============ -->
			<footer class="site-footer">
				<span>© The Blue Meridian Club</span>
				<span>By Invitation Only</span>
			</footer>
		</main>

		<style>
			:root {
				--ink: #0a1628;
				--gold: #d4af6f;
				--paper: #f4f1ea;
			}
			* { box-sizing: border-box; margin: 0; padding: 0; }
			html, body { height: auto; }
			body {
				font-family: 'Inter', system-ui, -apple-system, sans-serif;
				color: var(--paper);
				background: var(--ink);
				-webkit-font-smoothing: antialiased;
			}

			/* ===== Nav ===== */
			.nav {
				position: fixed;
				top: 0; left: 0; right: 0;
				z-index: 10;
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 1.4rem 2.5rem;
				background: linear-gradient(180deg, rgba(10, 22, 40, 0.55) 0%, transparent 100%);
			}
			.wordmark {
				color: var(--paper);
				text-decoration: none;
				font-family: 'Cormorant Garamond', Georgia, serif;
				font-weight: 600;
				font-size: 1.15rem;
				letter-spacing: 0.25em;
				text-transform: uppercase;
			}
			.nav-links {
				display: flex;
				gap: 2.25rem;
				list-style: none;
				align-items: center;
			}
			.nav-links a {
				color: rgba(244, 241, 234, 0.85);
				text-decoration: none;
				font-size: 0.74rem;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				font-weight: 500;
				transition: color 0.2s ease;
			}
			.nav-links a:hover { color: var(--gold); }
			.nav-cta {
				border: 1px solid rgba(212, 175, 111, 0.7);
				padding: 0.55rem 1.15rem;
				color: var(--gold) !important;
			}
			.nav-cta:hover { background: var(--gold); color: var(--ink) !important; }
			@media (max-width: 720px) {
				.nav { padding: 1.1rem 1.25rem; }
				.nav-links { gap: 1rem; }
				.nav-links li:not(:last-child) { display: none; }
			}

			/* ===== Hero ===== */
			.hero {
				position: relative;
				min-height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				text-align: center;
				overflow: hidden;
			}
			.hero-bg {
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse at 50% 30%, rgba(212, 175, 111, 0.18) 0%, transparent 60%),
					linear-gradient(180deg, #06304a 0%, #0a4d6e 22%, #0f6b94 45%, #1a8db5 65%, #2bb0c9 82%, #4dd0a8 100%);
				background-size: cover;
				background-position: center;
			}
			/* Drop public/hero.jpg, then uncomment to use real photo as hero bg */
			/*
			.hero-bg { background-image: url('/hero.jpg'); background-size: cover; background-position: center; }
			*/
			.hero-overlay {
				position: absolute;
				inset: 0;
				background: linear-gradient(180deg, rgba(10, 22, 40, 0.5) 0%, rgba(10, 22, 40, 0.12) 40%, rgba(10, 22, 40, 0.75) 100%);
			}
			.permit {
				position: absolute;
				top: 14%;
				left: 50%;
				width: min(640px, 70vw);
				transform: translateX(-50%);
				opacity: 0.85;
				animation: drift 9s ease-in-out infinite;
				filter: drop-shadow(0 8px 24px rgba(10, 22, 40, 0.4));
				z-index: 1;
			}
			@keyframes drift {
				0%, 100% { transform: translate(-50%, 0); }
				50% { transform: translate(calc(-50% + 14px), -10px); }
			}
			.hero-content {
				position: relative;
				z-index: 2;
				padding: 2rem;
				max-width: 820px;
				margin-top: 8rem;
			}
			.eyebrow {
				font-size: 0.8rem;
				letter-spacing: 0.45em;
				text-transform: uppercase;
				color: var(--gold);
				font-weight: 500;
				margin-bottom: 1.75rem;
			}
			h1 {
				font-family: 'Cormorant Garamond', Georgia, serif;
				font-weight: 500;
				font-size: clamp(2.5rem, 6.5vw, 5.25rem);
				line-height: 1.02;
				letter-spacing: -0.015em;
				margin-bottom: 1.75rem;
			}
			.tagline {
				font-size: clamp(1rem, 1.5vw, 1.18rem);
				font-weight: 300;
				line-height: 1.7;
				opacity: 0.92;
				margin-bottom: 2.75rem;
			}
			.cta {
				display: inline-block;
				padding: 0.95rem 2.75rem;
				border: 1px solid var(--gold);
				color: var(--gold);
				text-decoration: none;
				font-size: 0.78rem;
				letter-spacing: 0.35em;
				text-transform: uppercase;
				font-weight: 500;
				transition: background 0.3s ease, color 0.3s ease;
			}
			.cta:hover { background: var(--gold); color: var(--ink); }
			.cta-light { color: var(--paper); border-color: var(--paper); }
			.cta-light:hover { background: var(--paper); color: var(--ink); }

			.hero-footer {
				position: absolute;
				bottom: 1.75rem;
				left: 0;
				right: 0;
				z-index: 2;
				text-align: center;
				font-size: 0.68rem;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				color: rgba(244, 241, 234, 0.55);
			}

			/* ===== Wellness Partner ===== */
			.partner {
				background: var(--paper);
				color: var(--ink);
				padding: 6rem 2rem;
			}
			.partner .eyebrow { color: #8a6a3a; }
			.partner-grid {
				max-width: 1100px;
				margin: 0 auto;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 4rem;
				align-items: center;
			}
			.partner-image img {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 2px;
				box-shadow: 0 20px 60px rgba(10, 22, 40, 0.18);
			}
			.partner-copy h2 {
				font-family: 'Cormorant Garamond', Georgia, serif;
				font-weight: 500;
				font-size: clamp(2.25rem, 4.5vw, 3.25rem);
				line-height: 1.05;
				margin-bottom: 0.5rem;
				color: var(--ink);
			}
			.partner-role {
				font-size: 0.85rem;
				letter-spacing: 0.25em;
				text-transform: uppercase;
				color: #8a6a3a;
				margin-bottom: 1.75rem;
				font-weight: 500;
			}
			.partner-body {
				font-size: 1.05rem;
				line-height: 1.75;
				font-weight: 300;
				color: #2a3a4e;
				margin-bottom: 2.25rem;
			}
			.partner .cta {
				color: #8a6a3a;
				border-color: #8a6a3a;
			}
			.partner .cta:hover { background: #8a6a3a; color: var(--paper); }
			@media (max-width: 820px) {
				.partner-grid { grid-template-columns: 1fr; gap: 2.5rem; }
				.partner { padding: 4rem 1.5rem; }
			}

			/* ===== Site Footer ===== */
			.site-footer {
				background: var(--ink);
				padding: 2rem 2.5rem;
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.7rem;
				letter-spacing: 0.3em;
				text-transform: uppercase;
				color: rgba(244, 241, 234, 0.4);
				border-top: 1px solid rgba(244, 241, 234, 0.1);
			}
			@media (max-width: 600px) {
				.site-footer { flex-direction: column; gap: 0.6rem; text-align: center; }
			}
		</style>
	</body>
</html>
